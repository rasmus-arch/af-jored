# Databas (MySQL/MariaDB)
DATABASE_URL="mysql://anvandare:losenord@localhost:3306/af_jored"

# Serverport (cPanel/Passenger sätter oftast PORT automatiskt)
PORT=3000
NODE_ENV=production

# Sessionshemlighet - byt till ett långt, slumpat värde i produktion
SESSION_SECRET="byt-mig-till-en-lang-slumpad-hemlighet"

# Bas-URL, används i länkar i e-post (inbjudan, glömt lösenord)
APP_BASE_URL="https://portal.joredspostformning.se"

# SMTP för utskick av e-post
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp-anvandare"
SMTP_PASS="smtp-losenord"
SMTP_FROM="Joreds återförsäljarportal <noreply@joredspostformning.se>"

# Giltighetstid för inbjudningar och återställning av lösenord (timmar)
INVITATION_EXPIRY_HOURS=72
PASSWORD_RESET_EXPIRY_HOURS=2

# Uppladdning av bilder/dokument
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR="./uploads"
