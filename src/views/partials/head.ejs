<!doctype html>
<html lang="sv">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> – Joreds återförsäljarportal</title>
  <link rel="stylesheet" href="/css/theme.css" />
  <% if (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.accentColor) { %>
    <style>:root { --color-accent: <%= siteSettings.accentColor %>; }</style>
  <% } %>
</head>
<body>
  <header class="site-header">
    <% if (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.logoUrl) { %>
      <a class="logo" href="/"><img src="<%= siteSettings.logoUrl %>" alt="Joreds återförsäljarportal" style="max-height:2.5rem;display:block" /></a>
    <% } else { %>
      <a class="logo" href="/">Joreds återförsäljarportal</a>
    <% } %>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <nav aria-label="Huvudmeny" class="site-nav">
        <% if (currentUser.role === 'RESELLER') { %>
          <a href="/portal">Startsida</a>
          <a href="/portal/sortiment">Sortiment</a>
          <a href="/portal/kalkylator">Priskalkylator</a>
          <a href="/portal/dokument">Dokument</a>
          <a href="/portal/prislista">Min prislista</a>
          <a href="/portal/mina-sidor">Min sida</a>
        <% } else if (currentUser.role === 'ADMIN') { %>
          <a href="/admin">Adminöversikt</a>
        <% } %>
        <a href="/konto">Mitt konto</a>
        <form method="post" action="/logga-ut" style="display:inline">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>" />
          <button type="submit">Logga ut</button>
        </form>
      </nav>
    <% } %>
  </header>
  <main class="site-main">
