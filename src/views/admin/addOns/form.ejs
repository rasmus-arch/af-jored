<%- include('../../partials/head', { title }) %>
  <%- include('../_nav') %>
  <h1><%= title %></h1>
  <% if (error) { %><p class="error-message" role="alert"><%= error %></p><% } %>

  <form method="post" action="<%= addOn && addOn.id ? '/admin/tillval/' + addOn.id : '/admin/tillval' %>" class="card">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>" />

    <label for="name">Namn</label>
    <input type="text" id="name" name="name" value="<%= addOn ? addOn.name : '' %>" required />

    <label for="description">Beskrivning</label>
    <textarea id="description" name="description" rows="3"><%= addOn ? (addOn.description || '') : '' %></textarea>

    <label for="priceUnit">Prisenhet</label>
    <select id="priceUnit" name="priceUnit">
      <option value="STYCK" <%= (!addOn || addOn.priceUnit === 'STYCK') ? 'selected' : '' %>>Kr per styck</option>
      <option value="LOPMETER" <%= addOn && addOn.priceUnit === 'LOPMETER' ? 'selected' : '' %>>Kr per löpmeter</option>
    </select>

    <fieldset>
      <legend>Tillgängligt för material</legend>
      <% materials.forEach(m => { %>
        <label class="checkbox-label">
          <input type="checkbox" name="materialIds" value="<%= m.id %>" <%= selectedMaterialIds.includes(m.id) ? 'checked' : '' %> />
          <%= m.name %>
        </label>
      <% }) %>
    </fieldset>

    <button type="submit">Spara</button>
    <a class="button" style="background:#6b685f;margin-left:.5rem" href="/admin/tillval">Avbryt</a>
  </form>
<%- include('../../partials/footer') %>
