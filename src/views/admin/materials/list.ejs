<%- include('../../partials/head', { title }) %>
  <%- include('../_nav') %>
  <h1>Material</h1>
  <p><a class="button" href="/admin/material/nytt">Nytt material</a></p>

  <table class="admin-table">
    <thead>
      <tr>
        <th scope="col">Bild</th>
        <th scope="col">Namn</th>
        <th scope="col">Sortering</th>
        <th scope="col">Status</th>
        <th scope="col">Åtgärder</th>
      </tr>
    </thead>
    <tbody>
      <% materials.forEach(m => { %>
        <tr>
          <td><% if (m.imageUrl) { %><img class="thumb" src="<%= m.imageUrl %>" alt="" /><% } %></td>
          <td><%= m.name %></td>
          <td><%= m.sortOrder %></td>
          <td><span class="badge <%= m.active ? 'badge-active' : 'badge-inactive' %>"><%= m.active ? 'Aktiv' : 'Inaktiv' %></span></td>
          <td>
            <a href="/admin/material/<%= m.id %>/redigera">Redigera</a>
            <form class="inline-form" method="post" action="/admin/material/<%= m.id %>/vaxla-aktiv">
              <input type="hidden" name="csrf_token" value="<%= csrfToken %>" />
              <button class="button-link" type="submit"><%= m.active ? 'Inaktivera' : 'Aktivera' %></button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<%- include('../../partials/footer') %>
