<%- include('../../partials/head', { title }) %>
  <%- include('../_nav') %>
  <h1>Förhandsgranska dekorimport</h1>
  <% const okRows = rows.filter(r => r.errors.length === 0); %>
  <% const errorRows = rows.filter(r => r.errors.length > 0); %>
  <p><%= okRows.length %> av <%= rows.length %> rader kan importeras. <% if (errorRows.length > 0) { %><%= errorRows.length %> rad(er) har fel och hoppas över.<% } %></p>

  <table class="admin-table">
    <thead>
      <tr>
        <th scope="col">Rad</th><th scope="col">Artikelkod</th><th scope="col">Namn</th><th scope="col">Åtgärd</th><th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(r => { %>
        <tr>
          <td><%= r.rowNumber %></td>
          <td><%= r.data.articleCode %></td>
          <td><%= r.data.name %></td>
          <td><%= r.action === 'update' ? 'Uppdaterar befintlig' : 'Skapar ny' %></td>
          <td>
            <% if (r.errors.length === 0) { %>
              <span class="badge badge-active">OK</span>
            <% } else { %>
              <span class="badge badge-inactive"><%= r.errors.join(' ') %></span>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <form method="post" action="/admin/import-export/dekorer/bekrafta">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>" />
    <button type="submit" <%= okRows.length === 0 ? 'disabled' : '' %>>Importera <%= okRows.length %> rad(er)</button>
    <a class="button" style="background:#6b685f;margin-left:.5rem" href="/admin/import-export">Avbryt</a>
  </form>
<%- include('../../partials/footer') %>
