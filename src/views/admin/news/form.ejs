<%- include('../../partials/head', { title }) %>
  <%- include('../_nav') %>
  <h1><%= title %></h1>
  <% if (error) { %><p class="error-message" role="alert"><%= error %></p><% } %>

  <form method="post" action="<%= post && post.id ? '/admin/nyheter/' + post.id : '/admin/nyheter' %>" class="card">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>" />
    <label for="title">Rubrik</label>
    <input type="text" id="title" name="title" value="<%= post ? post.title : '' %>" required />
    <label for="body">Text</label>
    <textarea id="body" name="body" rows="6" required><%= post ? post.body : '' %></textarea>
    <label for="publishedAt">Publiceringsdatum</label>
    <input type="date" id="publishedAt" name="publishedAt" value="<%= post && post.publishedAt ? post.publishedAt.toISOString().slice(0,10) : '' %>" />
    <button type="submit">Spara</button>
    <a class="button" style="background:#6b685f;margin-left:.5rem" href="/admin/nyheter">Avbryt</a>
  </form>
<%- include('../../partials/footer') %>
