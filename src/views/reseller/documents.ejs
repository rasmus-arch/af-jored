<%- include('../partials/head', { title }) %>
  <h1>Dokumentarkiv</h1>

  <% const categories = Object.keys(categoryLabels); %>
  <% let hasAny = false; %>
  <% categories.forEach(cat => { if (byCategory[cat] && byCategory[cat].length) hasAny = true; }) %>

  <% if (!hasAny) { %>
    <p>Inga dokument tillgängliga ännu.</p>
  <% } %>

  <% categories.forEach(cat => { %>
    <% if (byCategory[cat] && byCategory[cat].length > 0) { %>
      <div class="card">
        <h2><%= categoryLabels[cat] %></h2>
        <ul>
          <% byCategory[cat].forEach(d => { %>
            <li><a href="/portal/dokument/<%= d.id %>/hamta"><%= d.title %></a></li>
          <% }) %>
        </ul>
      </div>
    <% } %>
  <% }) %>
<%- include('../partials/footer') %>
