<%- include('../partials/head', { title }) %>
  <div class="form-container">
    <h1>Glömt lösenord</h1>
    <% if (sent) { %>
      <p>Om e-postadressen finns registrerad har vi skickat en länk för att återställa lösenordet.</p>
      <p><a href="/logga-in">Till inloggningen</a></p>
    <% } else { %>
      <% if (error) { %><p class="error-message" role="alert"><%= error %></p><% } %>
      <p>Ange din e-postadress så skickar vi en länk för att välja ett nytt lösenord.</p>
      <form method="post" action="/glomt-losenord" novalidate>
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>" />
        <label for="email">E-postadress</label>
        <input type="email" id="email" name="email" autocomplete="username" required autofocus />
        <button type="submit">Skicka länk</button>
      </form>
    <% } %>
  </div>
<%- include('../partials/footer') %>
