<%- include('../partials/head', { title }) %>
  <div class="form-container">
    <h1>Återställ lösenord</h1>
    <% if (error) { %><p class="error-message" role="alert"><%= error %></p><% } %>
    <form method="post" action="/aterstall-losenord/<%= token %>" novalidate>
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>" />
      <label for="password">Nytt lösenord (minst 10 tecken)</label>
      <input type="password" id="password" name="password" autocomplete="new-password" minlength="10" required autofocus />
      <label for="passwordConfirm">Bekräfta nytt lösenord</label>
      <input type="password" id="passwordConfirm" name="passwordConfirm" autocomplete="new-password" minlength="10" required />
      <button type="submit">Spara nytt lösenord</button>
    </form>
  </div>
<%- include('../partials/footer') %>
